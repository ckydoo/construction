{
  "name": "buildops",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "setup": "npm install && npx prisma db push && npm run db:seed && npm run dev",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f prisma/dev.db && npx prisma db push && node scripts/seed.mjs",
    "preview": "npm run build && npm run start",
    "start:prod": "node scripts/prod-start.mjs",
    "db:postgres": "node scripts/switch-provider.mjs",
    "audit": "tsx scripts/audit-defs.ts > /tmp/defs.json && python3 scripts/audit.py && tsx scripts/audit-core.ts",
    "audit:defs": "tsx scripts/audit-defs.ts > /tmp/defs.json",
    "audit:core": "tsx scripts/audit-core.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@tanstack/react-query": "^5.62.7",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
