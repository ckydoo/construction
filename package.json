{
  "name": "myla",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "setup": "npm install && npm run db:migrate && npm run db:seed && npm run dev",
    "db:migrate": "supabase db push",
    "db:push": "npm run db:migrate",
    "db:seed": "tsx scripts/seed-supabase.ts",
    "db:reset": "supabase db reset && npm run db:seed",
    "db:local": "supabase start && supabase db reset && npm run db:seed",
    "rbac:generate": "tsx scripts/audit-defs.ts > /tmp/defs.json && python3 scripts/gen-supabase-rbac.py",
    "preview": "npm run build && npm run start",
    "start:prod": "node scripts/prod-start.mjs",
    "audit": "tsx scripts/audit-defs.ts > /tmp/defs.json && python3 scripts/audit.py && tsx scripts/audit-core.ts && python3 scripts/report.py",
    "audit:defs": "tsx scripts/audit-defs.ts > /tmp/defs.json",
    "audit:core": "tsx scripts/audit-core.ts",
    "audit:browser": "node scripts/browser-audit.mjs",
    "audit:onboarding": "node scripts/onboarding-audit.mjs",
    "audit:all": "npm run audit && npm run audit:browser",
    "audit:live": "npm run audit && npm run audit:browser && npm run audit:onboarding",
    "audit:report": "python3 scripts/report.py",
    "predb:migrate": "node scripts/ensure-env.mjs",
    "predb:push": "node scripts/ensure-env.mjs",
    "predb:seed": "node scripts/ensure-env.mjs",
    "predb:reset": "node scripts/ensure-env.mjs",
    "predev": "node scripts/ensure-env.mjs",
    "prebuild": "node scripts/ensure-env.mjs",
    "prestart": "node scripts/ensure-env.mjs",
    "prestart:prod": "node scripts/ensure-env.mjs",
    "env:init": "node scripts/ensure-env.mjs",
    "env:check": "node scripts/check-env.mjs",
    "audit:projects": "node scripts/project-scale-audit.mjs",
    "rbac:staff": "tsx scripts/staff-defs.ts > /tmp/staff-defs.json && python3 scripts/gen-staff-scope.py",
    "audit:features": "node scripts/feature-audit.mjs",
    "audit:finance": "node scripts/finance-module-audit.mjs",
    "audit:billing": "node scripts/billing-audit.mjs",
    "audit:sample-data": "node scripts/sample-data-default-qa.mjs",
    "audit:dpo-prod": "node scripts/dpo-production-smoke.mjs",
    "audit:platform-config": "node scripts/platform-config-qa.mjs",
    "audit:convert": "node scripts/conversion-qa.mjs",
    "audit:quote-studio": "node scripts/quote-studio-qa.mjs",
    "audit:document-preview": "node scripts/document-preview-qa.mjs",
    "audit:overlay": "node scripts/overlay-qa.mjs",
    "audit:user-copy": "tsx scripts/user-copy-qa.ts",
    "audit:support-paynow": "node scripts/support-paynow-qa.mjs",
    "audit:email-notifications": "node scripts/email-notifications-qa.mjs",
    "audit:topbar": "node scripts/topbar-currency-qa.mjs",
    "audit:workflow": "tsx scripts/workflow-defs-qa.ts && node scripts/workflow-qa.mjs",
    "audit:profitability": "tsx scripts/profitability-defs-qa.ts && node scripts/profitability-qa.mjs",
    "audit:three-way-match": "tsx scripts/three-way-match-defs-qa.ts && node scripts/three-way-match-qa.mjs",
    "audit:simplicity": "node scripts/simplicity-audit.mjs",
    "audit:test-fixes": "tsx scripts/test-fix-audit.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "2.49.1",
    "@tanstack/react-query": "^5.62.7",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.65.0",
    "postcss": "^8.4.49",
    "supabase": "^2.20.12",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
