# Public configuration only. NEVER put service-role keys, passwords or Expo tokens here.
# Deploy the bearer-auth backend changes before connecting the native app.
EXPO_PUBLIC_API_URL=https://app.myla.co.zw
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set these after running `eas init` with the intended Expo account.
EXPO_OWNER=
EXPO_PUBLIC_EAS_PROJECT_ID=
