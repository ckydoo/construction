# ── Database ────────────────────────────────────────────────────────────
# Default: SQLite file (works with the Docker/Render blueprint + persistent disk)
DATABASE_URL="file:./dev.db"
# For Postgres (Vercel / Neon / Supabase / Render Postgres), run `npm run db:postgres`
# then set:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/buildops?schema=public"

# ── Server ──────────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="production"
SESSION_SECRET="replace-with-a-long-random-string"

# ── Boot behaviour ──────────────────────────────────────────────────────
# Seeds 616 demo records on first boot only (when the database has no organization)
SEED_DEMO="true"
# Where uploaded files are stored; use a persistent volume in production
UPLOAD_ROOT=""
