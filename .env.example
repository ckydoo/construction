# BuildOps — environment variable template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and replace the empty values. `.env` is ignored by
# Git and Docker, so real keys never land in the repository. This template is
# safe to commit.
#
# NEXT_PUBLIC_* values ARE sent to the browser. Never put a service-role key,
# secret key, password or private token in a NEXT_PUBLIC_* variable.
#
# The app is fully Supabase-backed: Postgres + Auth + Storage + RLS. Sections
# 1–2 are required. Sections 3–10 are named slots for optional integrations;
# adding a key does not switch the feature on yet.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1 · Core (read by the app today) ────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
TZ="Africa/Harare"

# Used by OAuth callbacks, emailed links and the browser audit suite.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUDIT_BASE="http://127.0.0.1:3000"
LOG_LEVEL="info"

# ── 2 · Supabase (REQUIRED) ─────────────────────────────────────────────────
# Project Settings → API. URL + anon key are browser-safe; service-role is NOT.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_WEBHOOK_SECRET=""
SUPABASE_PROJECT_REF=""
SUPABASE_REGION=""

# Project Settings → Database → Connection string. Used only by the CLI for
# `supabase db push` / `supabase db reset` (never by the running app).
SUPABASE_DB_PASSWORD=""
SUPABASE_DATABASE_URL=""
SUPABASE_DIRECT_URL=""
DIRECT_URL=""

# Private Storage bucket created by supabase/migrations/0004_storage.sql.
SUPABASE_STORAGE_BUCKET="buildops-documents"
MAX_FILE_BYTES="12582912"

# supabase | local | s3 | r2 — only `supabase` is implemented.
STORAGE_DRIVER="supabase"

# Apply schema: npx supabase link --project-ref <ref> && npx supabase db push
# Seed demo data: npm run db:seed
# Local stack:    npx supabase start && npx supabase db reset

# ── 3 · Object storage (optional, not implemented) ─────────────────────────
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# ── 4 · Email / notifications ───────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="BuildOps <no-reply@example.com>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# ── 5 · SMS / WhatsApp (site alerts, OTP, payment reminders) ───────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_BUSINESS_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ── 6 · Payments (ZW-friendly + international) ────────────────────────────
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
PAYNOW_RETURN_URL=""
PAYNOW_RESULT_URL=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"

# ── 7 · Maps / weather / geocoding ─────────────────────────────────────────
# Restrict browser keys by HTTP referrer / domain in the provider console.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
OPENWEATHER_API_KEY=""

# ── 8 · SSO / OAuth ─────────────────────────────────────────────────────────
AUTH_CALLBACK_BASE_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# ── 9 · Accounting / ERP connectors ────────────────────────────────────────
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_TENANT_ID=""
XERO_WEBHOOK_SIGNING_KEY=""
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REALM_ID=""
SAGE_CLIENT_ID=""
SAGE_CLIENT_SECRET=""

# ── 10 · Webhooks, internal API, monitoring, AI ────────────────────────────
# 32-byte hex key for encrypting connector credentials at rest.
INTEGRATIONS_ENCRYPTION_KEY=""
BUILDOPS_API_KEY=""
BUILDOPS_WEBHOOK_SECRET=""
SLACK_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""
TEAMS_WEBHOOK_URL=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
OPENAI_API_KEY=""
